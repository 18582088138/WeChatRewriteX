# Copy to <persistent-runtime>/.env; configure runtime location using CLI/process env.
WENSHU_TEAM_MODE=1
WENSHU_MIN_FREE_MB=256
# APP_ACCESS_TOKEN never substitutes for member login in team mode.
APP_ACCESS_TOKEN=
# Prefer offline --init-admin. Set a temporary random >=24-character bootstrap token
# only when using first-run browser initialization, then remove it.
WENSHU_BOOTSTRAP_TOKEN=
# Add exact trusted origins only when a separate frontend is actually deployed.
WENSHU_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Existing model/search keys remain optional; administrator manages them on host.
# OPENAI_API_KEY=
