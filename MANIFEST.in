recursive-include app/_assets *
recursive-include app/storage *.sql
recursive-include app/services/cards/themes *.yaml *.html
include README.md
include .env.example
include pyproject.toml requirements.lock requirements-dev.lock CHANGELOG.md Dockerfile .dockerignore
include requirements-build.lock
recursive-include config *.yaml *.j2 *.md *.txt *.png
recursive-include docs *.md
recursive-include scripts *.py *.bat *.ps1 *.sh
recursive-include tools *.py
recursive-include packaging *.spec *.sh
recursive-include tests *.py *.md *.txt *.json *.png *.html
recursive-include web/src *
recursive-include web/e2e *.ts
include web/package.json web/package-lock.json web/index.html web/*.config.* web/tsconfig*.json
recursive-include .github/workflows *.yml
global-exclude __pycache__ *.pyc
