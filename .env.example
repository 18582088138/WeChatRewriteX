# ===== LLM 渠道密钥（按需填写，未填的渠道自动跳过）=====
# DeepSeek（https://platform.deepseek.com）
DEEPSEEK_API_KEY=
# 火山方舟 / 豆包（https://www.volcengine.com/product/ark），也可用于 embedding
ARK_API_KEY=
# OpenAI 兼容的其他渠道（可选）
OPENAI_API_KEY=

# ===== 搜索（可选，未配置则关联搜索降级为「仅原文」）=====
TAVILY_API_KEY=
BING_SEARCH_KEY=

# ===== 访问令牌（局域网/手机访问时必须设置；本机 127.0.0.1 可留空）=====
APP_ACCESS_TOKEN=

# ===== 网络代理（可选；Windows 默认读取系统 PAC 自动代理）=====
# 优先于系统代理，例如 http://127.0.0.1:7890；无需填写 PAC 脚本地址
WENSHU_HTTP_PROXY=
